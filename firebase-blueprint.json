{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "Ordem de serviço ou manutenção",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Member": {
      "title": "Member",
      "description": "Membro da equipe de manutenção",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Categoria de manutenção",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "ProblemTemplate": {
      "title": "ProblemTemplate",
      "description": "Problema e solução pré-fixada",
      "type": "object",
      "properties": {
        "title": { "type": "string" }
      }
    },
    "Location": {
      "title": "Location",
      "description": "Local físico do Salão do Reino",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Orçamento mensal planejado",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "planned": { "type": "number" },
        "spent": { "type": "number" }
      }
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Equipamento e patrimônio do Salão do Reino",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "FCMToken": {
      "title": "FCMToken",
      "description": "Tokens de registro do Firebase Cloud Messaging para notificações push no Android",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "platform": { "type": "string" },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "FCMNotification": {
      "title": "FCMNotification",
      "description": "Histórico de disparos de notificações push FCM",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "targetTokens": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Coleção de ordens de serviço"
    },
    "/equipments/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Coleção de equipamentos e inventário patrimonial"
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Coleção de voluntários e membros da equipe"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Coleção de categorias de serviços"
    },
    "/problemTemplates/{problemId}": {
      "schema": { "$ref": "#/entities/ProblemTemplate" },
      "description": "Coleção de templates de problemas pré-fixados"
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Coleção de locais do imóvel"
    },
    "/monthlyBudgets/{monthId}": {
      "schema": { "$ref": "#/entities/MonthlyBudget" },
      "description": "Coleção de orçamentos mensais"
    },
    "/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FCMToken" },
      "description": "Tokens de dispositivos Android e Web registrados no FCM"
    },
    "/fcmNotifications/{notifId}": {
      "schema": { "$ref": "#/entities/FCMNotification" },
      "description": "Histórico de notificações enviadas via FCM"
    }
  }
}
